#!/bin/bash
# Read-only bridge from the desktop shell to the Basalt OS system
# assistant. Runs as root through pkexec (polkit action
# org.openbasalt.shell.assistant-read) and accepts only read commands:
# status, why UNIT, fix selinux, disk, snapshots, pending, show ID, audit N,
# submit ID (queue the proposal in the approval gate: a person decides
# there, nothing runs here), ask TEXT (the assistant's translator, which itself never runs a
# change) and translate (the desktop command bar's request to the same
# local model: a chat completions body on stdin, forwarded to the model's
# Unix socket, which only the assistant and administrators may open; the
# model has no power, its answer is validated by the shell), drivers,
# updates and channels (their reports; storing a proposal, which changes
# nothing until the person applies it). Package queries never run here:
# the updates and drivers reports are the ones the assistant's root units
# wrote (basalt-updates-check, basalt-drivers-refresh), and a test of the
# shell (internal/assistant/policy_test.go) refuses rpm or dnf in this
# file. Anything else is refused.
set -eu
PATH=/usr/sbin:/usr/bin
word='^[A-Za-z0-9@._:-]{1,100}$'
[ $# -ge 1 ] || { echo "usage: assistant-read COMMAND [ARGS]" >&2; exit 2; }
for a in "$@"; do
  case "$a" in --apply|--yes|--confirm|--confirm=*) echo "refused: $a is a change" >&2; exit 3 ;; esac
  # A rollback proposal is stored only by `drivers rollback --json` and
  # `updates rollback --json` below.
  if [ "$a" = rollback ] && [ "$1" != drivers ] && [ "$1" != updates ]; then echo "refused: $a is a change" >&2; exit 3; fi
done
cmd=$1; shift
case "$cmd" in
  status|disk|snapshots|pending)
    for a in "$@"; do case "$a" in --json|--all) ;; *) echo "refused argument" >&2; exit 3 ;; esac; done
    exec basalt "$cmd" "$@" ;;
  submit)
    [ $# -eq 1 ] && [[ $1 =~ ^p-[0-9a-f]{6}$ ]] || { echo "refused argument" >&2; exit 3; }
    exec basalt submit "$1" --json ;;
  why|show)
    [ $# -ge 1 ] && [[ $1 =~ $word ]] || { echo "refused argument" >&2; exit 3; }
    arg=$1; shift
    for a in "$@"; do case "$a" in --json) ;; *) echo "refused argument" >&2; exit 3 ;; esac; done
    exec basalt "$cmd" "$arg" "$@" ;;
  fix)
    [ "${1:-}" = selinux ] || { echo "refused" >&2; exit 3; }
    shift
    for a in "$@"; do case "$a" in --json|--since=*) ;; *) echo "refused argument" >&2; exit 3 ;; esac; done
    exec basalt fix selinux "$@" ;;
  audit)
    [ $# -le 1 ] && [[ ${1:-20} =~ ^[0-9]{1,4}$ ]] || { echo "refused argument" >&2; exit 3; }
    exec basalt audit "${1:-20}" ;;
  ask)
    [ $# -eq 1 ] && [ ${#1} -le 500 ] || { echo "refused" >&2; exit 3; }
    exec basalt ask --dry-run "$1" ;;
  translate)
    [ $# -eq 0 ] || { echo "refused" >&2; exit 3; }
    conf=/etc/basalt/assistant.conf
    sec=""; enabled=no; ep=""
    while IFS= read -r line; do
      line=${line%%#*}; line=$(printf '%s' "$line" | tr -d '[:space:]')
      case "$line" in
        \[*\]) sec=$line ;;
        enabled=*) [ "$sec" = "[translator]" ] && enabled=${line#enabled=} ;;
        endpoint=*) [ "$sec" = "[translator]" ] && ep=${line#endpoint=} ;;
      esac
    done < "$conf"
    [ "$enabled" = yes ] || [ "$enabled" = true ] || { echo "the translator is off in $conf" >&2; exit 4; }
    ep=${ep:-unix:/run/basalt-llm/llm.sock}
    case "$ep" in unix:/*) ;; *) echo "refused: only the local model's Unix socket" >&2; exit 3 ;; esac
    sock=${ep#unix:}
    [ -S "$sock" ] || { echo "the local model is not running ($sock)" >&2; exit 4; }
    body=$(head -c 65537)
    [ ${#body} -le 65536 ] || { echo "refused: request too large" >&2; exit 3; }
    printf '%s' "$body" | exec curl -sS --fail-with-body --max-time 60 --unix-socket "$sock" \
      -H 'Content-Type: application/json' --data-binary @- http://localhost/v1/chat/completions ;;
  drivers)
    # Only the report root's unit wrote (--cached): no rpm or dnf runs here.
    case "$*" in
      "--json --cached" | "license nvidia" | "rollback --json --cached" | "install nvidia --json --cached" | \
        "install nvidia display --json --cached" | "install nvidia compute --json --cached")
        exec basalt drivers "$@" ;;
      *) echo "refused argument" >&2; exit 3 ;;
    esac ;;
  updates)
    case "$*" in
      "" | "--json" | "status --json" | "install --json" | "install --security --json" | "rollback --json")
        exec basalt updates "$@" ;;
      *) echo "refused argument" >&2; exit 3 ;;
    esac ;;
  channels)
    repo='^[a-z][a-z0-9._-]{1,62}$'
    entry='^[a-z][a-z0-9-]{1,40}$'
    copr='^@?[A-Za-z0-9][A-Za-z0-9_.-]{0,63}/[A-Za-z0-9][A-Za-z0-9_.+-]{0,99}$'
    https='^https://[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?(/[A-Za-z0-9._~%/:?&=+,@$-]*)?$'
    name='^[A-Za-z0-9 ._()+-]{1,80}$'
    ok=no
    case $# in
      0) ok=yes ;;
      1) [ "$1" = --json ] && ok=yes ;;
      3) case "$1" in enable|disable|remove) [[ $2 =~ $repo ]] && [ "$3" = --json ] && ok=yes ;;
           add) [[ $2 =~ $entry ]] && [ "$2" != copr ] && [ "$2" != custom ] && [ "$3" = --json ] && ok=yes ;; esac ;;
      5) if [ "$1" = enable ] && [[ $2 =~ $repo ]] && [ "$3" = --consent ] && [ "$4" = preview-builds-1 ] && [ "$5" = --json ]; then ok=yes; fi
         if [ "$1" = add ] && [ "$2" = copr ] && [ "$3" = --id ] && [[ $4 =~ $copr ]] && [ "$5" = --json ]; then ok=yes; fi
         if [ "$1" = add ] && [ "$2" = custom ] && [ "$3" = --repo-url ] && [[ $4 =~ $https ]] && [ "$5" = --json ]; then ok=yes; fi ;;
      9) if [ "$1" = add ] && [ "$2" = custom ] && [ "$3" = --baseurl ] && [[ $4 =~ $https ]] && [ "$5" = --key-url ] &&
            [[ $6 =~ $https ]] && [ "$7" = --name ] && [[ $8 =~ $name ]] && [ "$9" = --json ]; then ok=yes; fi ;;
    esac
    [ "$ok" = yes ] || { echo "refused argument" >&2; exit 3; }
    exec basalt channels "$@" ;;
  *) echo "refused: $cmd is not a read command" >&2; exit 3 ;;
esac
