// Basalt shell session on niri.
//
// The shell is basalt-shell-ui (Quickshell). Window style (focus ring,
// corners, shadows, gaps, animations, cursor) lives in basalt-theme.kdl,
// next to this file, which the basalt-shell daemon rewrites from the theme
// tokens; niri reloads it live.
//
// Windows float by default; Super+T moves the focused window between the
// floating layer and niri's scrollable tiling.

include "basalt-theme.kdl"

input {
    keyboard {
        xkb {
        }
    }
    touchpad {
        tap
        natural-scroll
        dwt
    }
    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    center-focused-column "on-overflow"
    default-column-width { proportion 0.5; }
}

// Window decorations: apps draw their own title bar with buttons
// (client-side decorations; niri has no title bars of its own). GTK 4,
// libadwaita, GTK 3 (GTK_CSD=1 from the session), Firefox, Chromium,
// Electron, foot (Basalt's foot settings) and Qt (Adwaita plugin) do,
// showing maximize and close; xwayland-satellite gives X11 apps a title
// bar with the same buttons. niri draws the themed focus ring around
// every window. Any window can also be closed from its entry in the
// panel's window list (hover, or middle click), and the window menu
// (right click on that entry, or Super+Alt+Space) minimizes, maximizes,
// snaps, moves and closes it.
// Mouse: drag a title bar to move, its edges to resize, double click to
// maximize; Super+drag moves, Super+right-drag resizes.

// Floating by default, sized relative to the screen (works at any scale).
window-rule {
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.7; }
}

spawn-at-startup "basalt-session-init"
spawn-at-startup "basalt-shelld"
spawn-at-startup "basalt-shell-ui"

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

binds {
    Mod+Space { spawn "basalt-shell-ui" "ipc" "call" "shell" "toggle" "launcher"; }
    // Next keyboard layout (the session starts with the system's layouts).
    Mod+Shift+Space { switch-layout "next"; }
    Mod+D { spawn "basalt-shell-ui" "ipc" "call" "shell" "toggle" "launcher"; }
    Mod+A { spawn "basalt-shell-ui" "ipc" "call" "shell" "toggle" "commandbar"; }
    // Push to talk: niri has no key-release bindings, so Mod+V is a press
    // with no release to follow ("toggle"): press to start listening,
    // press again to send, whatever the person's push_to_talk setting is
    // (the same code path as sway's press). No key repeat, so a long
    // press does not stop at once. The panel's microphone button follows
    // the setting. Escape cancels through the voice card.
    Mod+V repeat=false { spawn "basalt-shell-ui" "ipc" "call" "shell" "voice" "toggle"; }
    Mod+Shift+Return { spawn "basalt-shell-ui" "ipc" "call" "shell" "voice" "insert"; }
    Mod+Shift+BackSpace { spawn "basalt-shell-ui" "ipc" "call" "shell" "voice" "discard"; }
    Mod+N { spawn "basalt-shell-ui" "ipc" "call" "shell" "toggle" "notifications"; }
    Mod+S { spawn "basalt-shell-ui" "ipc" "call" "shell" "toggle" "quicksettings"; }
    Mod+Comma { spawn "basalt-shell-ui" "ipc" "call" "shell" "toggle" "settings"; }
    Mod+Escape { spawn "basalt-shell-ui" "ipc" "call" "shell" "close"; }
    // The panel takes the keyboard: Left and Right move along it, Escape
    // gives the keyboard back (Ctrl+Alt+Tab as on GNOME, or Mod+B).
    Ctrl+Alt+Tab { spawn "basalt-shell-ui" "ipc" "call" "shell" "focusPanel"; }
    Mod+B { spawn "basalt-shell-ui" "ipc" "call" "shell" "focusPanel"; }
    // Stop an agent's control session at once.
    Mod+Shift+Escape { spawn "basalt-shell" "ctl" "control.stop"; }

    Mod+Return { spawn "foot"; }
    Mod+E { spawn "nautilus"; }
    Mod+Q { close-window; }
    Mod+F { fullscreen-window; }
    Mod+T { toggle-window-floating; }
    Mod+L { spawn "basalt-lock"; }
    // Window states through the shell (it remembers the size to
    // restore): maximize, snap to a half, restore or minimize (parked on
    // a "minimized" workspace, listed in the panel), the window menu.
    Mod+Up { spawn "basalt-shell-ui" "ipc" "call" "shell" "window" "maximize"; }
    Mod+Down { spawn "basalt-shell-ui" "ipc" "call" "shell" "window" "restore"; }
    Mod+Left { spawn "basalt-shell-ui" "ipc" "call" "shell" "window" "left"; }
    Mod+Right { spawn "basalt-shell-ui" "ipc" "call" "shell" "window" "right"; }
    Mod+H { spawn "basalt-shell-ui" "ipc" "call" "shell" "window" "minimize"; }
    Mod+Alt+Space { spawn "basalt-shell-ui" "ipc" "call" "shell" "window" "menu"; }
    Mod+Alt+Left { focus-column-or-monitor-left; }
    Mod+Alt+Right { focus-column-or-monitor-right; }
    Mod+Alt+Up { focus-window-or-workspace-up; }
    Mod+Alt+Down { focus-window-or-workspace-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Alt+Tab { focus-window-down-or-column-right; }
    Mod+O repeat=false { toggle-overview; }
    Print { screenshot; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    // The shell's power menu (lock, log out, suspend, restart, power off);
    // without a running shell UI, niri's own quit confirmation.
    Mod+Shift+E { spawn "sh" "-c" "basalt-shell-ui ipc call shell toggle power || niri msg action quit"; }
}

// Local additions (keybindings, window rules, outputs): kept across updates.
include "local.kdl"
