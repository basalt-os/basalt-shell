# Enabled for every person by preset (80-basalt-shell.preset) and started
# with the session (basalt-session.target); when its socket is missing
# anyway, push to talk starts it. Not socket activated: the service
# creates its runtime directory itself, so it gets its own SELinux type
# (basalt_voice_runtime_t) and only the shell daemon can reach it, and it
# is light when idle (no microphone open, no model loaded: whisper.cpp
# runs per utterance, Piper only after the first spoken answer).
[Unit]
Description=Basalt voice: push to talk, local speech to text and text to speech
Documentation=file:///usr/share/doc/basalt-shell/voice.md
PartOf=basalt-session.target
After=pipewire.service pipewire-pulse.service
ConditionPathExists=/etc/basalt/voice.conf

[Service]
Type=simple
EnvironmentFile=/etc/basalt/voice.conf
ExecStart=/usr/bin/basalt-voiced
Restart=on-failure
RestartSec=3s
# No network at all (the SELinux domain has none either): Unix sockets
# only, for PipeWire and the shell daemon.
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=no
Nice=-2
WorkingDirectory=%t

[Install]
WantedBy=basalt-session.target
