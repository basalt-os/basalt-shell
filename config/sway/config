# Basalt shell session on sway (the default session of the desktop
# edition; also the headless session for agents).
#
# The shell (panel, launcher, command bar, notifications, settings) is
# basalt-shell-ui (Quickshell); window style (borders, gaps, colors) is
# applied at runtime by the daemon (basalt-shelld) from the theme tokens,
# so nothing here hardcodes colors.
#
# Windows float by default, like most desktops. Tiling is one key away:
# Super+T tiles or floats the focused window, the Windows settings page and
# the command bar ("tile windows") arrange a whole workspace.

set $mod Mod4
set $ui basalt-shell-ui ipc call shell

# Floating by default (Wayland and X11 windows).
for_window [app_id=".*"] floating enable
for_window [class=".*"] floating enable
floating_modifier $mod normal
floating_minimum_size 240 x 160
focus_follows_mouse no

# Window decorations. Apps that draw their own title bar with buttons
# (GTK 4 / libadwaita, GTK 3 headerbars, Firefox, Chromium, Electron) keep
# it: sway honors their xdg-decoration request while they float and draws
# nothing around them. The daemon switches Qt apps to their own Adwaita
# title bar when the plugin is installed. Every other window (X11 apps,
# terminals, plain GTK 3) gets sway's title bar, themed by the daemon from
# the design tokens (font, colors, padding, frame width) and re-applied
# live when the theme changes. Drag the title bar (or Super+drag) to move,
# Super+right-drag or the window edge to resize.
default_border normal 2
default_floating_border normal 2
titlebar_border_thickness 1
titlebar_padding 12 6
title_align center
gaps inner 8

# XWayland for X11 apps.
xwayland enable

# Inputs: natural defaults; tap to click on touchpads.
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

# Session plumbing: environment for D-Bus activated services (portals),
# the session target (autostart), clipboard history and the idle lock.
exec basalt-session-init

# The shell.
exec basalt-shelld
exec basalt-shell-ui

# Shell surfaces.
bindsym $mod+space exec $ui toggle launcher
bindsym $mod+d exec $ui toggle launcher
bindsym $mod+a exec $ui toggle commandbar
bindsym $mod+n exec $ui toggle notifications
bindsym $mod+s exec $ui toggle quicksettings
bindsym $mod+comma exec $ui toggle settings
bindsym $mod+Escape exec $ui close
# Stop an agent's control session at once (any process may stop one).
bindsym $mod+Shift+Escape exec basalt-shell ctl control.stop
# Push to talk: hold Super+V and speak, release to send. The shell UI
# opens the microphone on the press and closes it on the release. With
# "Press to start and stop" (Settings, Voice and assistant) the daemon
# ignores the release and the next press sends.
bindsym --no-repeat $mod+v exec $ui voice press
bindsym --release $mod+v exec $ui voice release
# While a "press to start and stop" utterance listens the shell switches
# to this mode, so Escape cancels it; it goes back to the default mode
# when the microphone closes. Other keys reach the apps as usual.
mode "basalt-voice" {
    bindsym Escape exec $ui voice cancel
    bindsym --no-repeat $mod+v exec $ui voice press
    bindsym --release $mod+v exec $ui voice release
    bindsym $mod+Shift+Escape exec basalt-shell ctl control.stop
}
# Dictation into a focused text field waits on the voice card: Super+Shift+Return
# types it, Super+Shift+BackSpace drops it (or the card's buttons).
bindsym $mod+Shift+Return exec $ui voice insert
bindsym $mod+Shift+BackSpace exec $ui voice discard

# Apps and windows.
bindsym $mod+Return exec foot
bindsym $mod+e exec nautilus
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+t floating toggle
bindsym $mod+l exec basalt-lock
# Window states (the shell remembers the size to restore): maximize,
# snap to a half, restore or minimize, and the window menu. sway ignores
# the maximize and minimize requests of apps (it only advertises
# fullscreen), so these go through the shell; minimized windows wait in
# the panel's window list.
bindsym $mod+Up exec $ui window maximize
bindsym $mod+Down exec $ui window restore
bindsym $mod+Left exec $ui window left
bindsym $mod+Right exec $ui window right
bindsym $mod+h exec $ui window minimize
bindsym $mod+Alt+space exec $ui window menu
# Right click on a title bar drawn by sway: the window menu of that window
# (mouse bindings act on the window under the pointer).
bindsym button3 focus, exec $ui window menu
bindsym $mod+Alt+Left focus left
bindsym $mod+Alt+Right focus right
bindsym $mod+Alt+Up focus up
bindsym $mod+Alt+Down focus down
bindsym $mod+Shift+Left move left 40 px
bindsym $mod+Shift+Right move right 40 px
bindsym $mod+Shift+Up move up 40 px
bindsym $mod+Shift+Down move down 40 px
bindsym Alt+Tab focus next
bindsym Print exec grim -g "$(slurp)" - | wl-copy

# Workspaces.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

# Media keys.
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Super+Shift+E: the shell's power menu (lock, log out, suspend,
# restart, power off; log out, restart and power off ask first). Without
# a running shell UI, sway's own exit prompt.
bindsym $mod+Shift+e exec $ui toggle power || swaynag -t warning -m 'Exit sway? This ends your session.' -B 'Exit' 'swaymsg exit'

# Local additions (not overwritten by updates).
include ~/.config/basalt-shell/sway.d/*
