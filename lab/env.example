# Desktop lab settings (lab/build-lab.sh). Copy to <lab dir>/.env and adjust.
# Same variables as basalt-os' env.example, plus the DESK_* ones.
FEDORA_RELEASE=44
PODMAN="sudo podman"
LAB_DIR=/srv/basalt-desk/lab
BUILD_DIR=/srv/basalt-desk/build
REPO_DIR=/srv/basalt-desk/repo
GNUPGHOME_LAB=/srv/basalt-desk/lab/gpg
BASALT_GPG_PUBKEY=/srv/basalt-desk/lab/gpg/RPM-GPG-KEY-basalt-lab
ISO_CACHE=/srv/basalt-desk/iso-cache
SITE_DIR=/srv/basalt-desk/lab/site
SITE_NAME=lab
VM_NETWORK=basalt-desk
VM_SUBNET=10.151.0
VM_BRIDGE=bsltdesk0
VM_MAC_PREFIX=52:54:00:51:00
VM_NAME=basalt-desk-vm1
VM_HOST=10
VM_MEMORY_MB=8192
VM_VCPUS=4
VM_DISK_GB=40
VM_DIR=/var/lib/libvirt/images/basalt-desk
REPO_PORT=8099
REPO_CONTAINER=basalt-desk-repo
LAB_REPO_URL=http://10.151.0.1:8099
TANG_PORT=7501
TANG_CONTAINER=basalt-desk-tang
EXTRA_SSH_PUBKEYS=
# Desktop user created by the site variant (logs in automatically).
DESK_USER=basalt
# Display: 1 = virtio-gpu with virgl rendered by the host GPU (egl-headless),
# 0 = 2D framebuffer (llvmpipe in the guest).
DESK_GL=1
DESK_RENDERNODE=/dev/dri/renderD128
# Where SPICE and VNC listen (127.0.0.1 = only through an SSH tunnel).
DESK_DISPLAY_LISTEN=127.0.0.1
DESK_SPICE_PORT=5931
DESK_VNC_PORT=5932
