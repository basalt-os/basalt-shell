#!/bin/bash
# Session start-up helpers run by the compositor config. In a nested
# session (BASALT_NESTED=1, a window inside another desktop) nothing is
# exported to the systemd user manager and no idle lock runs, so the host
# session is left alone.
set -u
if [ "${BASALT_NESTED:-0}" != 1 ]; then
  # Applications are started by the systemd user manager (in their own
  # scope), so it needs the session's toolkit environment too.
  vars="WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP
        QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_WAYLAND_DISABLE_WINDOWDECORATION MOZ_ENABLE_WAYLAND
        ELECTRON_OZONE_PLATFORM_HINT SDL_VIDEODRIVER _JAVA_AWT_WM_NONREPARENTING XCURSOR_THEME XCURSOR_SIZE
        BASALT_NIRI_CONFIG"
  # niri starts xwayland-satellite on demand and sets DISPLAY for its
  # children; wait briefly so it can be exported as well.
  for _ in 1 2 3 4 5; do [ -n "${DISPLAY:-}" ] && break; sleep 0.5; done
  vars="$vars SWAYSOCK NIRI_SOCKET"
  present=""
  for v in $vars; do [ -n "${!v:-}" ] && present="$present $v"; done
  # Portals left from an earlier session would talk to a dead display.
  systemctl --user stop xdg-desktop-portal.service xdg-desktop-portal-gtk.service \
    xdg-desktop-portal-wlr.service xdg-desktop-portal-gnome.service 2>/dev/null
  dbus-update-activation-environment --systemd $present
  systemctl --user import-environment $present
  systemctl --user start basalt-session.target
  swayidle -w timeout 900 basalt-lock before-sleep basalt-lock &
fi
# Screen sharing on sway asks which output to share (slurp); per-user
# default, kept if the person changed it.
share=${BASALT_SHELL_DATA:-/usr/share/basalt-shell}
xdpw=${XDG_CONFIG_HOME:-$HOME/.config}/xdg-desktop-portal-wlr/config
if [ -n "${SWAYSOCK:-}" ] && [ ! -e "$xdpw" ] && [ -f "$share/portals/xdpw-config" ]; then
  mkdir -p "$(dirname "$xdpw")" && cp "$share/portals/xdpw-config" "$xdpw"
fi
command -v cliphist >/dev/null && wl-paste --watch cliphist store &
wait
