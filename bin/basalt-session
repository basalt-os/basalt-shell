#!/bin/bash
# Start a Basalt shell session.
#   basalt-session [sway|niri]     a desktop session (default: sway, Fedora's package)
#   basalt-session headless        sway with no display, GPU or input devices: a
#                                  desktop for agents in VMs and servers (see
#                                  docs/headless.md); BASALT_HEADLESS_SIZE=WxH,
#                                  BASALT_HEADLESS_VNC=ADDR:PORT to watch and
#                                  confirm through wayvnc
# Used by the wayland-sessions entries, the nested "try it" scripts and
# basalt-headless.service.
set -eu

share=${BASALT_SHELL_DATA:-}
if [ -z "$share" ]; then
  for d in "$(dirname "$(readlink -f "$0")")/../share/basalt-shell" /usr/local/share/basalt-shell /usr/share/basalt-shell; do
    if [ -d "$d" ]; then share=$(readlink -f "$d"); break; fi
  done
fi
export BASALT_SHELL_DATA=$share

which=${1:-${BASALT_COMPOSITOR:-sway}}
[ "$which" = swayfx ] && which=sway

# Toolkit integration: Wayland first, X11 apps through XWayland (sway) or
# xwayland-satellite (niri); Qt 5 and Qt 6 follow qt5ct / qt6ct (palettes
# written by the daemon; Qt takes the first theme of the list it has,
# checked with Qt 5.15 and Qt 6.10; title bars below),
# GTK and libadwaita follow gsettings and the portal.
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="qt6ct:qt5ct"
# Qt windows draw the Adwaita title bar (Qt 6: qt6-qtwayland-adwaita-
# decoration, Qt 5: qadwaitadecorations-qt5) when the compositor asks for
# client-side decorations; the shell asks only when the plugin is there,
# so without it they keep the compositor's title bar.
unset QT_WAYLAND_DISABLE_WINDOWDECORATION
export QT_WAYLAND_DECORATION=adwaita
# GTK 3 windows without a header bar (Mousepad, older apps) draw their
# own title bar with buttons too (in the adw-gtk3 theme), like every
# GTK 4 window does; otherwise GTK 3 asks the compositor for its title
# bar, which has no buttons on sway and does not exist on niri.
export GTK_CSD=1
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export SDL_VIDEODRIVER="wayland,x11"
export _JAVA_AWT_WM_NONREPARENTING=1
# The keyboard layouts of the system (localectl set-x11-keymap writes
# 00-keyboard.conf; the greeter reads the same file): sway and niri use
# XKB_DEFAULT_* for keyboards without a configuration of their own, and
# without them the session typed with the US layout on a computer set to
# Brazilian ABNT2 (or any other), although the login screen used the
# right one. A person's own setting (these variables, or an input block in
# ~/.config/basalt-shell/sway.d) still wins.
if [ -z "${XKB_DEFAULT_LAYOUT:-}" ]; then
  kb=/etc/X11/xorg.conf.d/00-keyboard.conf
  xkb() { sed -n "s/^[[:space:]]*Option[[:space:]]*\"$1\"[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$kb" 2>/dev/null | head -n 1; }
  layout=$(xkb XkbLayout)
  if [ -n "$layout" ]; then
    export XKB_DEFAULT_LAYOUT="$layout"
    v=$(xkb XkbVariant); [ -n "$v" ] && export XKB_DEFAULT_VARIANT="$v"
    v=$(xkb XkbOptions); [ -n "$v" ] && export XKB_DEFAULT_OPTIONS="$v"
    v=$(xkb XkbModel); [ -n "$v" ] && export XKB_DEFAULT_MODEL="$v"
  elif [ -r /etc/vconsole.conf ]; then
    km=$(sed -n 's/^KEYMAP="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/vconsole.conf | head -n 1)
    case $km in
      '') ;;
      uk) export XKB_DEFAULT_LAYOUT=gb ;;
      br-abnt2 | br-abnt) export XKB_DEFAULT_LAYOUT=br ;;
      *) export XKB_DEFAULT_LAYOUT="${km%%-*}" ;;
    esac
  fi
  unset kb layout v km
  unset -f xkb
fi

# Apps installed with Flatpak: their launchers and icons live under the
# Flatpak export directories, which only login shells add (profile.d) and
# the session is started without one. Without them the launcher and the
# panel showed Flatpak apps (Slack, Telegram, Spotify) with a generic icon,
# and so with Google Chrome too: its RPM installs its icons with
# xdg-icon-resource into the first data directory, which is Flatpak's
# when dnf runs from a login shell.
data=${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
for d in /var/lib/flatpak/exports/share "${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share"; do
  case ":$data:" in *":$d:"*) ;; *) data="$d:$data" ;; esac
done
export XDG_DATA_DIRS=$data
unset data d
export XCURSOR_THEME=${XCURSOR_THEME:-Adwaita}
export XCURSOR_SIZE=${XCURSOR_SIZE:-24}
# wlroots refuses a software EGL renderer (llvmpipe) unless this is set,
# and SwayFX draws with GLES only (no pixman): without it the session
# cannot start on a machine or VM with no GPU and falls back to the login
# screen. A hardware GPU is still used when there is one; the shell turns
# the effects off when the renderer is software.
export WLR_RENDERER_ALLOW_SOFTWARE=${WLR_RENDERER_ALLOW_SOFTWARE:-1}

# Messages for the journal (greetd does not keep a session's stderr).
log() {
  printf 'basalt-session: %s\n' "$*" >&2
  command -v logger >/dev/null 2>&1 && logger -t basalt-session -- "$*" 2>/dev/null
  return 0
}

# Prints the DRM driver of a virtual machine's display adapter, if one
# drives a display: virtio-gpu (with or without virgl), QXL, bochs (std
# VGA), Cirrus, VMware SVGA, VirtualBox, Hyper-V, or the firmware
# framebuffer (simpledrm, efidrm, vesadrm) when a hypervisor is present.
virtual_display_driver() {
  local card dev drv hv=0
  if grep -qw hypervisor /proc/cpuinfo 2>/dev/null || [ -e /sys/hypervisor/type ]; then hv=1; fi
  for card in /sys/class/drm/card[0-9]*; do
    # Connectors (card1-Virtual-1) are not devices.
    case ${card##*/} in *-*) continue ;; esac
    drv=""
    # virtio-gpu: the PCI function is bound to virtio-pci and the DRM
    # driver to its virtio child device.
    for dev in "$card"/device/virtio*/driver "$card"/device/driver; do
      if [ -e "$dev" ]; then drv=$(basename "$(readlink -f "$dev")"); break; fi
    done
    case $drv in
      virtio_gpu | qxl | bochs-drm | bochs | cirrus | cirrus-qemu | vmwgfx | vboxvideo | hyperv_drm)
        echo "$drv"; return 0 ;;
      simple-framebuffer | simpledrm | efidrm | vesadrm | efi-framebuffer | vesa-framebuffer)
        if [ "$hv" = 1 ]; then echo "$drv"; return 0; fi ;;
    esac
  done
  return 1
}

# Virtual GPUs and the hardware cursor plane: QEMU and the other
# hypervisors take the cursor plane's image and hotspot and draw the
# pointer in the viewer (virt-manager, SPICE, VNC) themselves. With
# wlroots on virtio-gpu the image arrives shifted inside its 64x64 buffer
# (Adwaita's arrow 41 rows below its hotspot, checked with virgl), so the
# pointer the person sees is not where clicks go and the top bar cannot
# be reached. wlroots then draws the cursor into the frame itself. Only
# for a session on a display: nested and headless sessions use no cursor
# plane. Set WLR_NO_HARDWARE_CURSORS=0 to keep the cursor plane.
if [ -z "${WLR_NO_HARDWARE_CURSORS+x}" ] && [ "$which" != headless ] &&
  [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
  if vgpu=$(virtual_display_driver); then
    export WLR_NO_HARDWARE_CURSORS=1
    log "virtual display adapter ($vgpu): WLR_NO_HARDWARE_CURSORS=1 (software cursor)"
    # The viewer then draws its own pointer next to the session's (or the
    # last image an earlier session left): give QEMU an empty, hidden
    # cursor while no compositor holds the card.
    for d in "$(dirname "$(readlink -f "$0")")/../libexec/basalt-shell" /usr/local/libexec/basalt-shell /usr/libexec/basalt-shell; do
      if [ -x "$d/basalt-vm-cursor" ]; then
        out=$("$d/basalt-vm-cursor" 2>&1) || true
        [ -n "$out" ] && log "$out"
        break
      fi
    done
  fi
fi

conf=${XDG_CONFIG_HOME:-$HOME/.config}/basalt-shell
mkdir -p "$conf/sway.d"

# The NVIDIA driver (Basalt OS: basalt-nonfree, nvidia-driver): sway and
# SwayFX refuse to start while NVIDIA's kernel module is loaded unless
# given --unsupported-gpu, even on a laptop where the integrated GPU drives
# the display and NVIDIA only renders on demand (PRIME offload). wlroots
# works with the NVIDIA driver 560 and newer (GBM, explicit sync), and
# NVIDIA's own application profile already limits its video memory pool
# for wlroots compositors. niri needs no flag (its memory profile comes
# with basalt-nvidia).
sway_flags=""
if [ -e /sys/module/nvidia ]; then
  sway_flags=--unsupported-gpu
fi

if [ "$which" = headless ]; then
  # No display, no GPU needed: wlroots' headless backend with the pixman
  # (CPU) renderer unless a render node exists; Quickshell draws with Qt's
  # software renderer. Its own socket and state, so it can run next to a
  # desktop session of the same user.
  export WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 WLR_HEADLESS_OUTPUTS=1
  if ! ls /dev/dri/renderD* >/dev/null 2>&1 || [ "${BASALT_HEADLESS_GPU:-0}" != 1 ]; then
    export WLR_RENDERER=pixman QT_QUICK_BACKEND=software LIBGL_ALWAYS_SOFTWARE=1
  fi
  export BASALT_HEADLESS=1 BASALT_SHELL_WEAK=1
  rt=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}
  export BASALT_SHELL_SOCKET=${BASALT_SHELL_SOCKET:-$rt/basalt-shell-headless/shell.sock}
  export BASALT_SHELL_STATE_DIR=${BASALT_SHELL_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/basalt-shell-headless}
  unset WAYLAND_DISPLAY DISPLAY NIRI_SOCKET SWAYSOCK
  size=${BASALT_HEADLESS_SIZE:-1920x1080}
  [[ $size =~ ^[0-9]{3,5}x[0-9]{3,5}$ ]] || { echo "basalt-session: BASALT_HEADLESS_SIZE must be WxH" >&2; exit 2; }
  # Not in the daemon's socket directory: the daemon creates that one
  # itself, so it gets the SELinux type agents may reach.
  hc=$rt/basalt-headless-sway.conf
  printf 'include %s/sway/config\noutput HEADLESS-1 resolution %s position 0 0 scale 1\n' "$share" "$size" >"$hc"
  export BASALT_SHELL_COMPOSITOR=sway XDG_CURRENT_DESKTOP=sway:Basalt XDG_SESSION_DESKTOP=sway
  # shellcheck disable=SC2086 # empty or one flag
  exec sway $sway_flags -c "$hc" "${@:2}"
fi

# Nested in another desktop (a window): keep the host session untouched,
# including its GTK and Qt settings, unless BASALT_SHELL_APPS=1.
if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
  export BASALT_NESTED=1
  [ "${BASALT_SHELL_APPS:-0}" = 1 ] || export BASALT_SHELL_NO_APPS=1
fi

# When the compositor exits, stop the session's user services (portals,
# autostarted apps) so the next session starts them with its own
# environment instead of reusing ones bound to a dead display.
session_end() {
  [ "${BASALT_NESTED:-0}" = 1 ] && return
  systemctl --user stop basalt-session.target graphical-session.target 2>/dev/null
  systemctl --user stop xdg-desktop-portal.service xdg-desktop-portal-gtk.service \
    xdg-desktop-portal-wlr.service xdg-desktop-portal-gnome.service 2>/dev/null
  systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY SWAYSOCK NIRI_SOCKET 2>/dev/null
}
trap 'session_end; exit 0' TERM HUP

case "$which" in
  sway)
    # A nested session must not see the host compositor's socket.
    unset NIRI_SOCKET SWAYSOCK
    export BASALT_SHELL_COMPOSITOR=sway
    export XDG_CURRENT_DESKTOP=sway:Basalt
    export XDG_SESSION_DESKTOP=sway
    # shellcheck disable=SC2086 # empty or one flag
    sway $sway_flags -c "$share/sway/config" "${@:2}" &
    wait $!
    session_end
    ;;
  niri)
    unset NIRI_SOCKET SWAYSOCK
    export BASALT_SHELL_COMPOSITOR=niri
    export XDG_CURRENT_DESKTOP=niri:Basalt
    export XDG_SESSION_DESKTOP=niri
    # niri reads NIRI_CONFIG; the theme include is written next to it.
    mkdir -p "$conf/niri"
    cp -n "$share/niri/basalt-theme.kdl" "$conf/niri/basalt-theme.kdl" 2>/dev/null || true
    [ -e "$conf/niri/local.kdl" ] || printf '// Your additions to the Basalt niri config (kept across updates).\n' >"$conf/niri/local.kdl"
    if [ ! -e "$conf/niri/config.kdl" ] || [ "$conf/niri/config.kdl" -ot "$share/niri/config.kdl" ]; then
      cp "$share/niri/config.kdl" "$conf/niri/config.kdl"
    fi
    export NIRI_CONFIG="$conf/niri/config.kdl" BASALT_NIRI_CONFIG="$conf/niri/config.kdl"
    if [ "${BASALT_NESTED:-0}" = 1 ]; then exec niri "${@:2}"; fi
    niri --session "${@:2}" &
    wait $!
    session_end
    ;;
  *)
    echo "basalt-session: unknown session $which (sway, niri or headless)" >&2
    exit 2
    ;;
esac
