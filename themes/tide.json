{
  "id": "tide",
  "name": "Tide",
  "description": "Cool slate and sea blue, tighter corners, panel at the bottom.",
  "tokens": {
    "font.family": "Noto Sans",
    "font.mono": "JetBrains Mono",
    "font.size": 11,
    "font.scale": 1.2,
    "radius.sm": 4,
    "radius.md": 6,
    "radius.lg": 10,
    "radius.xl": 12,
    "radius.window": 8,
    "spacing.unit": 4,
    "panel.height": 40,
    "panel.position": "bottom",
    "panel.opacity": 0.92,
    "panel.style": "attached",
    "elevation.shadow": 0.35,
    "elevation.blur": 20,
    "motion.fast": 100,
    "motion.normal": 180,
    "motion.slow": 280,
    "motion.easing": "InOutQuad",
    "window.gaps": 6,
    "window.border": 1,
    "window.shadows": true,
    "window.blur": false,
    "window.dimInactive": 0,
    "apps.iconTheme": "Adwaita",
    "apps.cursorTheme": "Adwaita",
    "apps.cursorSize": 24,
    "apps.palette": "full"
  },
  "light": {
    "color.bg": "#f6f8fb",
    "color.surface": "#ecf0f5",
    "color.surfaceAlt": "#ffffff",
    "color.border": "#d2dae4",
    "color.text": "#1e2733",
    "color.textMuted": "#5b6778",
    "color.accent": "#2c6fb7",
    "color.accentText": "#ffffff",
    "color.success": "#2f8059",
    "color.warning": "#9a6a00",
    "color.danger": "#b4342c",
    "color.scrim": "#1e273366"
  },
  "dark": {
    "color.bg": "#0f141b",
    "color.surface": "#151c25",
    "color.surfaceAlt": "#1e2732",
    "color.border": "#2e3a49",
    "color.text": "#e3eaf2",
    "color.textMuted": "#93a1b3",
    "color.accent": "#5aa2e6",
    "color.accentText": "#08121d",
    "color.success": "#5bb98a",
    "color.warning": "#d8a840",
    "color.danger": "#e56a62",
    "color.scrim": "#05080cb3"
  }
